# Spring Boot 环境变量示例（不会自动加载 .env；请在终端、IDE 或容器中注入）
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/wechat_saas?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=
APP_JWT_SECRET=replace-with-at-least-32-bytes-random-secret
APP_JWT_EXPIRATION_HOURS=12
APP_SEED_ENABLED=true
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174


# 微信登录、订阅消息与支付（本地默认 mock）
APP_WECHAT_MOCK=true
APP_WECHAT_APP_ID=
APP_WECHAT_APP_SECRET=
APP_WECHAT_MCH_ID=
APP_WECHAT_API_V3_KEY=
APP_WECHAT_PRIVATE_KEY=
APP_WECHAT_SERIAL_NO=
APP_WECHAT_PUBLIC_KEY=
APP_WECHAT_PUBLIC_KEY_ID=
APP_WECHAT_NOTIFY_URL=https://your-domain.com/api/wx/pay/notify
APP_WECHAT_PAYMENT_ENABLED=false
# JSON 示例：{"orderPaid":{"templateId":"真实模板ID","page":"pages/orders/orders"}}
APP_WECHAT_SUBSCRIBE_TEMPLATES={}

