.orders-page { padding-top:24rpx; }
.page-heading { padding:8rpx 2rpx 26rpx; }
.eyebrow { display:block; color:#9b3c2b; font-size:21rpx; font-weight:700; letter-spacing:2rpx; }
.page-title { display:block; margin-top:8rpx; font-family:"Songti SC","STSong",serif; font-size:42rpx; font-weight:700; line-height:1.3; }
.order-card { padding:0; overflow:hidden; }
.order-head { display:flex; align-items:flex-start; justify-content:space-between; padding:26rpx 26rpx 18rpx; background:linear-gradient(135deg,#f4eee7,#fbfaf6); }
.order-no { font-size:25rpx; font-weight:700; color:#292723; }
.order-time { margin-top:6rpx; color:#807a70; font-size:22rpx; }
.status-pill { flex-shrink:0; padding:7rpx 14rpx; border-radius:999rpx; background:#ede9df; color:#5f574d; font-size:21rpx; font-weight:700; }
.status-pending { background:#f8e7df; color:#a63c28; }
.status-paid,.status-delivering { background:#eee2d5; color:#81563d; }
.status-completed { background:#e5ece4; color:#466248; }
.status-refunding { background:#f7ead1; color:#8a5a15; }
.status-cancelled,.status-refunded { background:#eceae5; color:#777168; }
.order-items { padding:22rpx 26rpx 10rpx; color:#373430; font-size:27rpx; line-height:1.65; }
.status-hint { margin:0 26rpx 18rpx; padding:12rpx 16rpx; border-left:5rpx solid #b84a35; background:#faf2ed; color:#76564a; font-size:23rpx; }
.order-foot { display:flex; align-items:center; justify-content:space-between; padding:20rpx 26rpx 24rpx; border-top:1rpx solid #eeeae2; }
.amount-label { margin-right:8rpx; color:#827c72; font-size:22rpx; }
.price { font-family:Georgia,serif; font-size:34rpx; }
.order-actions { display:flex; align-items:center; }
.order-actions button + button { margin-left:10rpx; }
.btn-small { height:62rpx; margin:0; padding:0 22rpx; line-height:62rpx; font-size:23rpx; }
.btn-text { background:transparent; color:#8e3c2a; font-weight:600; }
.btn-text::after,.btn-primary::after,.btn-ghost::after { border:0; }
.sheet-mask { position:fixed; top:0; right:0; bottom:0; left:0; z-index:20; display:flex; align-items:flex-end; background:rgba(34,31,27,.44); }
.detail-sheet { display:flex; flex-direction:column; width:100%; max-height:92vh; overflow:hidden; border-radius:30rpx 30rpx 0 0; background:#fbfaf6; box-shadow:0 -24rpx 60rpx rgba(35,29,23,.18); }
.sheet-grip { width:72rpx; height:8rpx; margin:16rpx auto 8rpx; border-radius:99rpx; background:#d7d1c7; }
.detail-head { display:flex; align-items:flex-start; justify-content:space-between; padding:18rpx 28rpx 22rpx; border-bottom:1rpx solid #ebe6dd; }
.detail-title { display:block; margin-top:5rpx; color:#25231f; font-family:Georgia,"Songti SC",serif; font-size:34rpx; font-weight:700; }
.detail-subtitle { display:block; margin-top:7rpx; color:#817b71; font-size:22rpx; }
.detail-scroll { flex:1; overflow-y:auto; padding:22rpx 28rpx 12rpx; }
.pickup-ticket { position:relative; display:flex; align-items:stretch; min-height:162rpx; margin-bottom:22rpx; overflow:hidden; border:1rpx solid #e0c5b7; border-radius:18rpx; background:#fff9f4; }
.pickup-ticket > view:first-child { width:42%; padding:22rpx; background:#b84a35; color:#fff; }
.pickup-ticket text,.pickup-ticket small { display:block; font-size:21rpx; opacity:.8; }
.pickup-ticket .pickup-code { display:block; margin:8rpx 0; font-family:Georgia,serif; font-size:44rpx; font-weight:700; letter-spacing:4rpx; opacity:1; }
.pickup-caption { display:block; font-size:21rpx; opacity:.8; }
.ticket-rule { width:1rpx; margin:16rpx -1rpx; border-left:2rpx dashed #e6d7cc; }
.ticket-store { flex:1; min-width:0; padding:24rpx 20rpx; color:#4e463e; }
.ticket-store text { font-size:26rpx; font-weight:700; opacity:1; }
.ticket-store small { margin-top:10rpx; line-height:1.5; opacity:1; }
.detail-section { margin-bottom:20rpx; padding:24rpx; border:1rpx solid #e9e4db; border-radius:16rpx; background:#fff; }
.section-label { margin-bottom:16rpx; color:#282520; font-family:"Songti SC","STSong",serif; font-size:29rpx; font-weight:700; }
.line-item { display:flex; justify-content:space-between; padding:15rpx 0; border-bottom:1rpx solid #f0ece5; }
.line-title { color:#37332d; font-size:25rpx; font-weight:700; }
.line-meta { margin-top:4rpx; color:#8b8479; font-size:21rpx; }
.amount-list { padding-top:12rpx; }
.amount-list > view { display:flex; justify-content:space-between; padding:8rpx 0; color:#736c62; font-size:23rpx; }
.amount-total { margin-top:8rpx; padding-top:16rpx !important; border-top:1rpx solid #e8e2d9; color:#282520 !important; font-size:27rpx !important; }
.amount-key { color:inherit; }
.total-amount { color:#a63c28; font-size:32rpx; font-weight:700; }
.info-row { display:flex; justify-content:space-between; padding:14rpx 0; border-bottom:1rpx solid #f1ede6; font-size:23rpx; }
.info-row:last-child { border-bottom:0; }
.info-row .info-key { flex-shrink:0; color:#857e74; }
.info-row text { max-width:70%; color:#37332d; text-align:right; white-space:pre-line; }
.info-row.warning { color:#9a4b22; }
.after-sales-row { display:flex; align-items:flex-start; justify-content:space-between; padding:14rpx 0; border-bottom:1rpx solid #f0ece5; }
.after-sales-row:last-child { border-bottom:0; }
.after-sales-title { font-size:24rpx; font-weight:700; }
.after-sales-meta { margin-top:5rpx; color:#817a70; font-size:21rpx; }
.resolution { margin-top:7rpx; color:#6c5a4f; font-size:21rpx; }
.empty-inline { padding:12rpx 0; color:#8b8479; font-size:23rpx; line-height:1.6; }
.after-sales-form { padding:24rpx; border:1rpx solid #dfc9bc; border-radius:16rpx; background:#fffaf6; }
.picker-field,.form-row { display:flex; align-items:center; justify-content:space-between; min-height:76rpx; margin-bottom:14rpx; padding:0 18rpx; border:1rpx solid #e0d9cf; border-radius:10rpx; background:#fff; font-size:24rpx; }
.picker-field text { color:#8f3d2c; }
.form-row input { flex:1; text-align:right; }
.form-input { box-sizing:border-box; width:100%; height:76rpx; margin-bottom:14rpx; padding:0 18rpx; border:1rpx solid #e0d9cf; border-radius:10rpx; background:#fff; }
.form-textarea { box-sizing:border-box; width:100%; height:150rpx; padding:16rpx 18rpx; border:1rpx solid #e0d9cf; border-radius:10rpx; background:#fff; }
.form-actions { display:flex; justify-content:flex-end; margin-top:18rpx; }
.form-actions button + button { margin-left:12rpx; }
.detail-footer { display:flex; justify-content:flex-end; padding:18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom)); border-top:1rpx solid #e8e2d9; background:#fff; }
.detail-footer button { margin:0; }
.detail-footer button + button { margin-left:12rpx; }
