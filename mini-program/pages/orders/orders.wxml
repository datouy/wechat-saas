<view class="container">
  <view class="card" wx:for="{{orders}}" wx:key="id">
    <view class="order">
      <view class="order-head"><text>{{item.orderNo}}</text><text>{{item.statusText}}</text></view>
      <view class="order-items">{{item.itemsText}}</view>
      <view class="order-foot">
        <text class="price">¥{{item.payAmountYuan}}</text>
        <view>
          <button wx:if="{{item.status==='pending'}}" class="btn-primary" size="mini" bindtap="pay" data-id="{{item.id}}">去支付</button>
          <button wx:if="{{item.status==='delivering'}}" class="btn-ghost" size="mini" bindtap="complete" data-id="{{item.id}}">确认收货</button>
        </view>
      </view>
    </view>
  </view>
  <view wx:if="{{!orders.length}}" class="empty">暂无订单，去首页逛逛吧</view>
</view>
