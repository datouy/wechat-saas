<view class="container" wx:if="{{product}}">
  <view class="product-card">
    <image wx:if="{{product.image}}" class="product-image" src="{{product.image}}" mode="aspectFill"></image>
    <view wx:else class="product-image"></view>
    <view class="product-content">
      <view class="product-name">{{product.name}}</view>
      <view class="muted">{{groupBuy ? groupBuy.title : product.unit}}</view>
      <view class="row product-row">
        <text class="price">¥{{groupBuy ? (groupBuy.groupPrice / 100) : product.price}}</text>
        <view class="qty">
          <button bindtap="minus">-</button><text>{{qty}}</text><button bindtap="plus">+</button>
        </view>
      </view>
    </view>

    <view wx:if="{{deliveryType==='pickup'}}">
      <view class="choice {{pickupLocationId===item.id?'on':''}}" wx:for="{{locations}}" wx:key="id" bindtap="choosePickupLocation" data-id="{{item.id}}">
        <view>
          <view>{{item.name}}</view>
          <view class="muted">{{item.address}} · {{item.hours}}</view>
        </view>
      </view>
      <view wx:if="{{!locations.length}}" class="muted">当前门店暂未配置自提点</view>
    </view>
  </view>

  <view class="card">
    <view class="field-label">配送</view>
    <view class="segments">
      <view class="segment {{deliveryType==='delivery'?'on':''}}" bindtap="chooseDelivery" data-type="delivery">配送</view>
      <view class="segment {{deliveryType==='pickup'?'on':''}}" bindtap="chooseDelivery" data-type="pickup">自提</view>
    </view>

    <view wx:if="{{deliveryType==='delivery'}}">
      <view class="choice {{addressId===item.id?'on':''}}" wx:for="{{addresses}}" wx:key="id" bindtap="chooseAddress" data-id="{{item.id}}">
        <view>
          <view>{{item.name}} {{item.phone}}</view>
          <view class="muted">{{item.detail}}</view>
        </view>
      </view>
      <button class="btn-ghost address-button" bindtap="toggleAddressForm">{{showAddressForm ? '取消' : '新增地址'}}</button>
      <view wx:if="{{showAddressForm}}" class="address-form">
        <input class="input" placeholder="收货人" value="{{addressDraft.name}}" data-field="name" bindinput="onAddressInput"/>
        <input class="input" type="number" placeholder="手机号" value="{{addressDraft.phone}}" data-field="phone" bindinput="onAddressInput"/>
        <input class="input" placeholder="详细地址" value="{{addressDraft.detail}}" data-field="detail" bindinput="onAddressInput"/>
        <button class="btn-primary" bindtap="saveAddress">保存地址</button>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="row section-row"><text>优惠券</text><text wx:if="{{couponId}}" class="link" bindtap="clearCoupon">不使用</text></view>
    <view class="coupon {{couponId===item.id?'on':''}}" wx:for="{{coupons}}" wx:key="id" data-id="{{item.id}}" bindtap="chooseCoupon">
      <view><text>{{item.name}}</text><view class="muted">满 {{item.thresholdText}} 可用</view></view>
      <text>-¥{{item.amountText}}</text>
    </view>
    <view wx:if="{{!coupons.length}}" class="muted">暂无可用优惠券</view>
    <view class="claim-list" wx:if="{{couponTemplates.length}}">
      <view class="claim" wx:for="{{couponTemplates}}" wx:key="id">
        <view><text>{{item.name}}</text><view class="muted">满 {{item.threshold}} 减 {{item.amount}}</view></view>
        <button class="btn-ghost mini" data-id="{{item.id}}" bindtap="claimCoupon">领取</button>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="row">
      <text>积分</text>
      <input class="points-input" type="number" placeholder="0" value="{{usePoints}}" bindinput="onPoints"/>
    </view>
    <view class="muted">余额 {{pointsBalance}}</view>
    <input class="input remark" placeholder="订单备注" value="{{remark}}" bindinput="onRemark"/>
  </view>

  <view class="card summary">
    <view class="row"><text class="muted">商品</text><text>¥{{goodsText}}</text></view>
    <view class="row" wx:if="{{couponText!=='0.00'}}"><text class="muted">优惠券</text><text>-¥{{couponText}}</text></view>
    <view class="row" wx:if="{{pointsText!=='0.00'}}"><text class="muted">积分</text><text>-¥{{pointsText}}</text></view>
    <view class="row" wx:if="{{deliveryType==='delivery' && deliveryText!=='0.00'}}"><text class="muted">配送</text><text>¥{{deliveryText}}</text></view>
    <view class="row total-row"><text>合计</text><text class="total">¥{{totalText}}</text></view>
  </view>

  <button class="btn-primary action" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">{{submitting ? '正在提交' : '确认支付'}}</button>
</view>
