.product-card { display:flex; gap:24rpx; padding:4rpx 0 28rpx; }
.product-image { width:180rpx; height:180rpx; flex-shrink:0; border-radius:16rpx; background:#e9e9e4; }
.product-content { flex:1; min-width:0; }
.product-name { margin-bottom:8rpx; font-size:32rpx; font-weight:650; }
.product-row { margin-top:22rpx; padding:0; }
.segments { display:flex; gap:8rpx; margin:12rpx 0 8rpx; padding:6rpx; background:#f1f1ed; border-radius:12rpx; }
.segment { flex:1; padding:12rpx; text-align:center; border-radius:9rpx; color:#666660; }
.segment.on { background:#fff; color:#9b3c2b; font-weight:600; box-shadow:0 1rpx 4rpx rgba(0,0,0,.06); }
.address-button { margin-top:14rpx; }
.address-form { display:flex; flex-direction:column; gap:12rpx; margin-top:16rpx; }
.section-row { padding-bottom:14rpx; font-weight:600; }
.link { color:#9b3c2b; font-size:24rpx; }
.coupon { display:flex; justify-content:space-between; gap:20rpx; padding:18rpx; margin-top:10rpx; border:1rpx solid #e6e6e1; border-radius:12rpx; }
.coupon.on { border-color:#b84a35; background:#fcf5f1; }
.claim-list { margin-top:16rpx; padding-top:8rpx; border-top:1rpx solid #efefeb; }
.claim { display:flex; align-items:center; justify-content:space-between; gap:20rpx; padding:14rpx 0; }
.mini { min-width:118rpx; margin:0; padding:0 20rpx; height:60rpx; line-height:60rpx; font-size:24rpx; }
.points-input { width:180rpx; padding:10rpx 14rpx; text-align:right; border:1rpx solid #dfdfda; border-radius:10rpx; }
.remark { margin-top:18rpx; }
.summary { padding-top:16rpx; padding-bottom:16rpx; }
.total-row { padding-top:18rpx; font-weight:650; }
.total { font-size:36rpx; }
.action { margin-top:20rpx; }
