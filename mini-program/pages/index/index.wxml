<view class="container">
  <view class="page-title">{{tenantName}}</view>

  <view class="service-row">
    <button class="service-action" bindtap="goBooking">预约服务</button>
    <button class="service-action" bindtap="goForms">问卷</button>
  </view>

  <view class="section-title" wx:if="{{groupBuys.length}}">团购</view>
  <view wx:if="{{groupBuys.length}}">
    <view class="gb-item" wx:for="{{groupBuys}}" wx:key="id" bindtap="goGroupBuy" data-id="{{item.id}}">
      <view class="gb-head"><text>{{item.title}}</text><text class="price">¥{{item.groupPriceYuan}}</text></view>
      <view class="progress"><view class="progress-value" style="width:{{item.progress}}%"></view></view>
      <view class="muted">{{item.participantCount}}/{{item.minParticipants}} 人</view>
    </view>
  </view>

  <view class="section-title">商品</view>
  <view class="card product-card">
    <view class="product-row" wx:for="{{products}}" wx:key="id" bindtap="goProduct" data-id="{{item.id}}">
      <image wx:if="{{item.image}}" class="thumb" src="{{item.image}}" mode="aspectFill"></image>
      <view wx:else class="thumb"></view>
      <view style="flex:1;min-width:0">
        <view class="product-name">{{item.name}}</view>
        <view class="muted product-unit">{{item.unit}}</view>
        <view><text class="price">¥{{item.price}}</text> <text class="muted">余 {{item.stock}}</text></view>
      </view>
    </view>
    <view wx:if="{{!products.length && !loading}}" class="empty">暂无商品</view>
  </view>
</view>
