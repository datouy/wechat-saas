.page-title { font-size:44rpx; font-weight:700; letter-spacing:-1rpx; }
.service-row { display:flex; gap:12rpx; margin:24rpx 0 4rpx; }
.service-action { flex:1; margin:0; padding:0 20rpx; height:72rpx; line-height:72rpx; background:#fff; border:1rpx solid #e8e8e3; border-radius:12rpx; color:#30302d; font-size:26rpx; }
.gb-item { padding:24rpx; background:#fff; border:1rpx solid #e8e8e3; border-radius:16rpx; margin-bottom:12rpx; }
.gb-head { display:flex; justify-content:space-between; gap:20rpx; font-weight:600; }
.progress { height:6rpx; margin:18rpx 0 10rpx; overflow:hidden; background:#edede8; border-radius:99rpx; }
.progress-value { height:100%; background:#b84a35; border-radius:99rpx; }
.product-card { padding-top:4rpx; padding-bottom:4rpx; }
.product-name { font-weight:600; }
.product-unit { margin:6rpx 0 12rpx; }
