page { background: #f5f7fa; font-size: 28rpx; color: #1f2937; }
.container { padding: 24rpx; }
.card { background: #fff; border-radius: 20rpx; padding: 24rpx; margin-bottom: 20rpx; }
.btn-primary { background: #07c160; color: #fff; border-radius: 12rpx; }
.btn-ghost { background: #fff; color: #07c160; border: 1rpx solid #07c160; border-radius: 12rpx; }
.price { color: #ef4444; font-weight: 700; }
.muted { color: #6b7280; font-size: 24rpx; }
.tag { display: inline-block; padding: 4rpx 16rpx; border-radius: 999rpx; background: #ecfdf5; color: #059669; font-size: 22rpx; }
.empty { text-align: center; color: #9ca3af; padding: 80rpx 0; }
