<view class="container">
  <view wx:if="{{!current}}">
    <view class="card" wx:for="{{forms}}" wx:key="id" bindtap="openForm" data-id="{{item.id}}">
      <view style="font-weight:700">{{item.title}}</view>
      <view class="muted" style="margin-top:8rpx">{{item.description}}</view>
      <view class="muted" style="margin-top:8rpx">共 {{item.fields.length}} 个问题</view>
    </view>
    <view wx:if="{{!forms.length}}" class="empty">暂无进行中的问卷</view>
  </view>

  <view wx:if="{{current}}">
    <view class="card">
      <view style="font-size:32rpx;font-weight:700">{{current.title}}</view>
      <view class="muted" style="margin-top:8rpx">{{current.description}}</view>
    </view>
    <view class="card">
      <view class="field" wx:for="{{current.fields}}" wx:key="id">
        <view class="label">{{item.label}}<text wx:if="{{item.required}}" style="color:#ef4444"> *</text></view>
        <input wx:if="{{item.type==='text'}}" data-fid="{{item.id}}" bindinput="onAnswer" placeholder="请输入"/>
        <textarea wx:if="{{item.type==='textarea'}}" data-fid="{{item.id}}" bindinput="onAnswer" placeholder="请输入" style="width:100%;height:120rpx;border:1rpx solid #e5e7eb;border-radius:8rpx;padding:12rpx"/>
        <input wx:if="{{item.type==='number'}}" type="number" data-fid="{{item.id}}" bindinput="onAnswer"/>
        <block wx:if="{{item.type==='radio'}}">
          <label class="choice" wx:for="{{item.options}}" wx:for-item="opt" wx:key="*this">
            <radio value="{{opt}}" data-fid="{{item.id}}" bindtap="onRadio" />{{opt}}
          </label>
        </block>
        <block wx:if="{{item.type==='checkbox'}}">
          <label class="choice" wx:for="{{item.options}}" wx:for-item="opt" wx:key="*this">
            <checkbox value="{{opt}}" data-fid="{{item.id}}" bindtap="onCheckbox" />{{opt}}
          </label>
        </block>
        <view wx:if="{{item.type==='rating'}}" class="rating">
          <text wx:for="{{stars}}" wx:for-item="s" wx:key="*this" data-fid="{{item.id}}" data-v="{{s}}" bindtap="onRating">{{s <= (answers[item.id]||0) ? '★' : '☆'}}</text>
        </view>
      </view>
      <button class="btn-primary" style="margin-top:16rpx" bindtap="submit">提交问卷</button>
    </view>
    <view class="card"><button class="btn-ghost" bindtap="back">返回列表</button></view>
  </view>
</view>
