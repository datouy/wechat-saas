<view class="container" wx:if="{{product}}">
  <image wx:if="{{product.image}}" class="big-thumb" src="{{product.image}}" mode="aspectFill"></image>
  <view wx:else class="big-thumb"></view>
  <view class="product-heading">
    <view class="product-title">{{product.name}}</view>
    <view class="muted product-meta">{{product.unit}} · 库存 {{product.stock}}</view>
    <view class="price product-price" wx:if="{{!groupBuy}}">¥{{product.price}}</view>
  </view>

  <view class="card group-card" wx:if="{{groupBuy}}">
    <view class="row">
      <text class="group-name">{{groupBuy.title}}</text>
      <text class="tag">{{groupStatusText}}</text>
    </view>
    <view class="price group-price">¥{{groupPriceYuan}}</view>
    <view class="progress"><view class="progress-value" style="width:{{groupBuy.participantCount/groupBuy.minParticipants*100}}%"></view></view>
    <view class="row group-progress-row">
      <text class="muted">{{groupBuy.participantCount}}/{{groupBuy.minParticipants}} 人</text>
      <text class="muted">原价 ¥{{product.price}}</text>
    </view>
  </view>

  <button class="btn-primary action" bindtap="primaryAction" disabled="{{groupCtaDisabled}}">{{groupBuy ? groupCtaText : '去结算'}}</button>
</view>
