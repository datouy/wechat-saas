<view class="container">
  <view class="card" wx:for="{{services}}" wx:key="id">
    <view style="font-weight:700">{{item.name}}</view>
    <view class="muted" style="margin:6rpx 0">¥{{item.price}} · {{item.durationMinutes}}分钟</view>
    <view style="margin-top:10rpx">
      <text class="muted">预约日期：</text>
      <picker mode="date" data-id="{{item.id}}" bindchange="onDate">
        <view style="display:inline-block;padding:10rpx 20rpx;background:#f3f4f6;border-radius:10rpx">{{dates[item.id] || '选择日期'}}</view>
      </picker>
    </view>
    <view style="margin-top:14rpx" wx:if="{{slotsMap[item.id]}}">
      <view class="slot {{s.available<=0?'full':''}} {{selected[item.id]===s.slot?'on':''}}"
            wx:for="{{slotsMap[item.id]}}" wx:for-item="s" wx:key="slot"
            data-sid="{{item.id}}" data-slot="{{s.slot}}" data-available="{{s.available}}"
            bindtap="pickSlot">
        {{s.slot}} ({{s.available>0?s.available+'位':'已满'}})
      </view>
    </view>
    <button class="btn-primary" style="margin-top:18rpx" data-id="{{item.id}}" bindtap="book">提交预约</button>
  </view>
  <view wx:if="{{!services.length}}" class="empty">暂无可预约服务</view>

  <view class="card" wx:if="{{mine.length}}">
    <view style="font-weight:700;margin-bottom:12rpx">我的预约</view>
    <view wx:for="{{mine}}" wx:key="id" style="display:flex;justify-content:space-between;padding:12rpx 0;border-bottom:1rpx solid #f3f4f6">
      <text>{{item.serviceName}} · {{item.date}} {{item.slot}}</text>
      <text class="muted">{{item.statusText}}</text>
    </view>
  </view>
</view>
