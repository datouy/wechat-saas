<view class="container mine-page">
  <view class="member-hero">
    <view class="avatar">{{memberInitial}}</view>
    <view class="member-copy">
      <text class="eyebrow">会员中心</text>
      <text class="member-name">{{member.nickname || '微信用户'}}</text>
      <text class="member-id">会员编号 {{member.id}}</text>
    </view>
    <view class="points-seal">
      <text class="seal-number">{{pointsBalance}}</text>
      <text class="seal-label">可用积分</text>
    </view>
  </view>

  <view class="card account-card">
    <view class="account-row" bindtap="openAddressManager">
      <view><text class="account-title">收货地址</text><text class="account-meta">配送结算从这里选择</text></view>
      <view class="account-end"><text>{{addresses.length}} 个</text><text class="chevron">›</text></view>
    </view>
    <view class="account-row" bindtap="openAfterSales">
      <view><text class="account-title">我的售后</text><text class="account-meta">退款、退货与投诉进度</text></view>
      <view class="account-end"><text wx:if="{{pendingAfterSales}}" class="pending-badge">{{pendingAfterSales}} 待处理</text><text class="chevron">›</text></view>
    </view>
    <view wx:if="{{storePhone}}" class="account-row" bindtap="callService">
      <view><text class="account-title">联系门店</text><text class="account-meta">{{storePhone}} · 09:00-20:00</text></view>
      <text class="chevron">›</text>
    </view>
  </view>

  <view class="card metric-card">
    <view class="stat-row">
      <view><view class="stat-num">{{pointsBalance}}</view><view class="muted">积分</view></view>
      <view><view class="stat-num">{{member.orderCount || 0}}</view><view class="muted">订单</view></view>
      <view><view class="stat-num">¥{{totalSpent}}</view><view class="muted">累计消费</view></view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">我的优惠券</view>
    <view wx:for="{{coupons}}" wx:key="id" class="coupon-row">
      <view><text class="coupon-name">{{item.name}}</text><text class="muted">满 ¥{{item.thresholdText}} 可用</text></view>
      <view class="coupon-value"><text>￥{{item.amountText}}</text><text class="coupon-status">{{item.statusText}}</text></view>
    </view>
    <view wx:if="{{!coupons.length}}" class="muted">暂无优惠券，可到活动页领取</view>
  </view>

  <view class="card">
    <view class="card-title">积分明细</view>
    <view wx:for="{{ledger}}" wx:key="id" class="ledger-row">
      <view><text class="ledger-reason">{{item.reason}}</text><text class="ledger-date">{{item.createdAtText}}</text></view>
      <text class="{{item.change>0?'positive':'negative'}}">{{item.change>0?'+':''}}{{item.change}}</text>
    </view>
    <view wx:if="{{!ledger.length}}" class="muted">暂无积分记录</view>
  </view>
</view>

<view wx:if="{{showAddressManager}}" class="manager-mask" bindtap="closeAddressManager" catchtouchmove="noop">
  <view class="manager-sheet" catchtap="noop">
    <view class="sheet-grip"></view>
    <view class="sheet-head">
      <view><text class="eyebrow">配送信息</text><text class="sheet-title">收货地址</text></view>
      <button class="close-button" bindtap="closeAddressManager">关闭</button>
    </view>

    <scroll-view wx:if="{{!showAddressForm}}" scroll-y class="manager-scroll">
      <view wx:for="{{addresses}}" wx:key="id" class="address-card">
        <view class="address-main">
          <view class="address-title">{{item.name}} · {{item.phone}}</view>
          <view class="address-detail">{{item.detail}}</view>
          <text wx:if="{{item.isDefault}}" class="default-tag">默认地址</text>
        </view>
        <view class="address-actions">
          <button wx:if="{{!item.isDefault}}" class="text-button" data-id="{{item.id}}" bindtap="setDefaultAddress">设为默认</button>
          <button class="text-button" data-id="{{item.id}}" bindtap="openAddressForm">编辑</button>
          <button class="text-button danger" data-id="{{item.id}}" bindtap="deleteAddress">删除</button>
        </view>
      </view>
      <view wx:if="{{!addresses.length}}" class="empty">还没有收货地址</view>
      <button class="btn-primary add-address" bindtap="openAddressForm">新增收货地址</button>
    </scroll-view>

    <scroll-view wx:else scroll-y class="manager-scroll form-scroll">
      <view class="form-label">收货人</view>
      <input class="form-input" value="{{addressDraft.name}}" data-field="name" bindinput="onAddressInput" maxlength="20" placeholder="请输入收货人姓名"/>
      <view class="form-label">手机号</view>
      <input class="form-input" type="number" value="{{addressDraft.phone}}" data-field="phone" bindinput="onAddressInput" maxlength="20" placeholder="用于配送联系"/>
      <view class="form-label">详细地址</view>
      <textarea class="form-textarea" value="{{addressDraft.detail}}" data-field="detail" bindinput="onAddressInput" maxlength="200" placeholder="小区、楼栋、门牌号"></textarea>
      <view class="switch-row"><view><text class="switch-title">设为默认地址</text><text class="switch-help">配送结算会优先使用</text></view><switch checked="{{addressDraft.isDefault}}" color="#b84a35" bindchange="onAddressDefault"/></view>
      <view class="form-actions">
        <button class="btn-ghost" bindtap="closeAddressForm">返回</button>
        <button class="btn-primary" loading="{{savingAddress}}" disabled="{{savingAddress}}" bindtap="saveAddress">保存地址</button>
      </view>
    </scroll-view>
  </view>
</view>

<view wx:if="{{showAfterSales}}" class="manager-mask" bindtap="closeAfterSales" catchtouchmove="noop">
  <view class="manager-sheet" catchtap="noop">
    <view class="sheet-grip"></view>
    <view class="sheet-head">
      <view><text class="eyebrow">服务进度</text><text class="sheet-title">我的售后</text></view>
      <button class="close-button" bindtap="closeAfterSales">关闭</button>
    </view>
    <scroll-view scroll-y class="manager-scroll">
      <view wx:for="{{afterSales}}" wx:key="id" class="after-sales-card" bindtap="openAfterSalesOrder" data-id="{{item.orderId}}">
        <view class="after-sales-head"><text>{{item.typeText}}</text><text class="after-status">{{item.statusText}}</text></view>
        <view class="after-order">{{item.orderNo}}</view>
        <view class="after-reason">{{item.reason}}</view>
        <view class="after-meta">{{item.createdAtText}}<text wx:if="{{item.requestedAmount}}"> · 申请退款 ¥{{item.requestedAmountText}}</text></view>
      </view>
      <view wx:if="{{!afterSales.length}}" class="empty"><view>暂无售后申请</view><view>可从订单详情发起</view></view>
    </scroll-view>
  </view>
</view>
