# 邻里团 SaaS 环境变量示例
# 复制为 .env 后按部署环境填写。.env 已被忽略，禁止提交真实密钥、证书或数据库口令。

# 运行环境：development | production | test
NODE_ENV=development
SERVICE_NAME=wechat-saas

# 服务
PORT=3100
HOST=0.0.0.0
CORS_ORIGINS=
# 反向代理层数或可信代理网段；例如 1、loopback 或 10.0.0.0/8
TRUST_PROXY=

# 存储后端：json（本地调试）| sqlite（单机 ACID）| postgres（生产多实例）
DATA_STORE=json
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
UPLOAD_MAX_BYTES=2097152

# PostgreSQL（DATA_STORE=postgres 时必填）
# 生产连接串建议显式带 sslmode=require，并遵循最小权限数据库账号原则
DATABASE_URL=
DATABASE_SSL=false
PG_POOL_MAX=20
PG_CONNECT_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=30000

# 应用内限流；多实例生产可由网关统一限流后关闭
RATE_LIMIT_DISABLED=false
# 限流模式：memory（单实例内存）| gateway（由网关/Redis 统一限流，应用内跳过）
RATE_LIMIT_MODE=memory
# 应用内单实例限流；中型试点默认每 IP 15 分钟 5000 次，会员登录 300 次，管理员登录 20 次
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=5000
RATE_LIMIT_LOGIN_MAX=20
RATE_LIMIT_MEMBER_LOGIN_MAX=300

# 认证（生产必填；请使用至少 32 字节的随机值）
AUTH_SECRET=
AUTH_MEMBER_TTL=604800
AUTH_ADMIN_TTL=43200
AUTH_PLATFORM_TTL=28800

# 租户管理员（生产环境必须使用强口令）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 平台运营账号（可开通、暂停租户并维护套餐账单）
PLATFORM_ADMIN_USERNAME=
PLATFORM_ADMIN_PASSWORD=

# 微信小程序登录与订阅消息（生产会拒绝 touristappid 占位值）
WX_APPID=
WX_SECRET=
# 事件 -> 模板配置。示例：
# WX_SUBSCRIBE_TEMPLATES={"orderPaid":{"templateId":"真实模板ID","page":"pages/orders/orders","data":{"thing1":{"value":"订单 {orderNo}"},"amount2":{"value":"{amount}"}}}}
WX_SUBSCRIBE_TEMPLATES={}

# 微信支付/退款本轮保持关闭。取得 AppID、商户资质与真实模板后再显式启用。
WX_PAYMENT_ENABLED=false
WX_MOCK=true
WX_MCHID=
WX_PAY_KEY=
WX_PAY_PRIVATE_KEY=
WX_PAY_SERIAL_NO=
# 推荐直接使用微信支付公钥模式；也可留空并让服务通过 /v3/certificates 自动下载平台证书
# PEM 支持原文、\n 转义换行，或使用 base64:<Base64编码的PEM>
WX_PAY_PUBLIC_KEY=
WX_PAY_PUBLIC_KEY_ID=
WX_NOTIFY_URL=https://your-domain.com/api/wx/pay/notify
WX_PAY_PLATFORM_CERTS={}

# 默认租户
DEFAULT_TENANT_ID=t-default
DEFAULT_TENANT_NAME=邻里团示范社区

# 租户自助开通与试用（生产按运营策略开启）
TENANT_SIGNUP_ENABLED=false
TENANT_TRIAL_DAYS=14
TENANT_DEFAULT_PLAN=starter

# 业务参数
ORDER_PAY_TIMEOUT_MINUTES=30
# 线下收款订单等待商家确认到账的时限（分钟）
ORDER_OFFLINE_TIMEOUT_MINUTES=1440
ORDER_AUTO_COMPLETE_DAYS=3
ORDER_DELIVERY_FEE=0
ORDER_PICKUP_REMINDER_HOURS=12
POINTS_ENABLED=true
POINTS_RATE_PER_YUAN=1
POINTS_COMMENT_REWARD=5
POINTS_MAX_PERCENT=50
COUPON_MAX_PER_ORDER=1
GROUPBUY_CLOSE_HOURS=24
GROUPBUY_ENDING_SOON_HOURS=24
LOW_STOCK_THRESHOLD=10

# 定时任务。API 实例可关闭；只有专用后台任务实例开启 worker。
ORDER_HOUSEKEEPING_ENABLED=true
GROUPBUY_AUTOCLOSE_ENABLED=true

# 持久化 Outbox：业务请求只入队，独立 worker 领取、重试和死信处理
OUTBOX_ENABLED=true
OUTBOX_WORKER_ENABLED=true
OUTBOX_INTERVAL_MS=5000
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_BATCH_SIZE=20
OUTBOX_BASE_DELAY_MS=30000
OUTBOX_LEASE_MS=120000

# 审计归档。S3 兼容存储须预先开启 Bucket Object Lock，并单独配置 WORM 账号。
AUDIT_ARCHIVE_ENABLED=false
AUDIT_ARCHIVE_WORKER_ENABLED=true
AUDIT_ARCHIVE_DIR=./archive/audit
AUDIT_ARCHIVE_INTERVAL_MS=60000
AUDIT_RETAIN_UNTIL_DAYS=3650
AUDIT_S3_ENDPOINT=
AUDIT_S3_REGION=us-east-1
AUDIT_S3_BUCKET=
AUDIT_S3_ACCESS_KEY_ID=
AUDIT_S3_SECRET_ACCESS_KEY=
AUDIT_S3_OBJECT_LOCK_MODE=COMPLIANCE

# 备份恢复：AES-256-GCM；生产必填至少32位，密钥由外部 Secret Manager 注入，禁止与备份同盘保存
# 完整恢复会写回数据库和上传素材；PostgreSQL 目标需使用专用恢复账号并显式允许覆盖
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
# 生产至少 32 位；使用 base64:<随机密钥> 或 Secret Manager 注入
BACKUP_ENCRYPTION_KEY=
# 单独灾备演练时可选；两条都必须指向隔离数据库，dr:drill:all 会自动启动临时 PostgreSQL
DRILL_DATABASE_URL=
DRILL_RESTORE_DATABASE_URL=

# 可观测性：Prometheus 抓取 /metrics 时使用 Bearer token
LOG_LEVEL=info
LOG_FILE=./logs/wechat-saas.log
LOG_MAX_BYTES=20971520
LOG_MAX_FILES=5
SLOW_REQUEST_MS=1000
# Prometheus Bearer token，生产至少 32 位
METRICS_TOKEN=
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=
ALERT_COOLDOWN_MS=300000
ALERT_WINDOW_MS=60000
