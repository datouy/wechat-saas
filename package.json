  "license": "MIT",
  "dependencies": {
    "dotenv": "^18.0.10",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
