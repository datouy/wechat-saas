# 邻里团 SaaS 环境变量示例
# 复制为 .env 并按需填写；.env 已被 .gitignore 排除，切勿提交真实密钥

# 运行环境：development | production
NODE_ENV=development

# 服务
PORT=3100
HOST=0.0.0.0

# 跨域白名单（逗号分隔，为空则不允许跨域）
CORS_ORIGINS=
DATA_DIR=./data
DATA_STORE=json

# 认证（生产环境必填，请用随机长密钥）
AUTH_SECRET=
AUTH_MEMBER_TTL=604800
AUTH_ADMIN_TTL=43200

# 默认管理员（生产环境必填，请修改密码）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 微信小程序
WX_APPID=
WX_SECRET=

# 微信支付（生产环境必填，且 WX_MOCK=false）
WX_MOCK=true
WX_MCHID=
WX_PAY_KEY=
WX_PAY_PRIVATE_KEY=
WX_PAY_SERIAL_NO=
WX_NOTIFY_URL=https://your-domain.com/api/wx/pay/notify
# 微信支付平台证书（JSON：序列号->PEM，用于回调验签）
WX_PAY_PLATFORM_CERTS={}

# 租户
DEFAULT_TENANT_ID=t-default
DEFAULT_TENANT_NAME=邻里团示范社区

# 业务参数
ORDER_PAY_TIMEOUT_MINUTES=30
ORDER_AUTO_COMPLETE_DAYS=3
POINTS_RATE_PER_YUAN=1
GROUPBUY_CLOSE_HOURS=24

